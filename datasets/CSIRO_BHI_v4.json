        "eo:bands": [
            {
                "description": "Biodiversity Habitat Index: Estimates the proportion of original native\nspecies richness and composition retained within each pixel considering\nlocal habitat condition and ecological context.\n",
                "name": "bhi",
                "gsd": [
                    1000
                ]
            },
            {
                "description": "Bioclimatic Ecosystem Resilience Index: Measures how well protected area\nnetworks represent the full diversity of terrestrial ecosystems.\n",
                "name": "beri",
                "gsd": [
                    1000
                ]
            },
            {
                "description": "Protected Area Representativeness: Measures spatial representativeness\nof protected area systems across ecological and climatic gradients.\n",
                "name": "parc_rep",
                "gsd": [
                    1000
                ]
            },
            {
                "description": "Protected Area Connectedness: Evaluates structural and functional landscape\nconnectivity between protected reserves, critical for species migration\nunder climate change.\n",
                "name": "parc_con",
                "gsd": [
                    1000
                ]
            },
            {
                "description": "Ecosystem Condition: Relative health and integrity of natural ecosystems\ncompared to undisturbed reference states (0-100%).\n",
